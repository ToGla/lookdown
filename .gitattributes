# Source files: normalize to LF in the repo and in the working tree, regardless of core.autocrlf.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Line-ending / encoding test fixtures: store byte-exact, never convert.
tests/fixtures/** -text

# Binary assets.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
